{
  "name": "air-cue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AIR CUE — Air Quality Intelligence Platform. Know the air. Make smarter decisions.",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/server.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "vite": "^8.3.6"
  }
}
