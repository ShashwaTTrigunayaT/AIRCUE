# AIR CUE server environment
# Copy to .env and fill in what you have. Every integration below is optional;
# the dashboard, map, forecast, history, comparison and Clean Air Finder work
# with no keys because Open-Meteo does not require one.

PORT=5000
NODE_ENV=development

# --- Optional: AI assistant + AI insights (Groq) -------------------------
# Create keys at https://console.groq.com/keys
# Comma/newline-separated pool: requests rotate keys, and a rejected or
# rate-limited key falls back to the next one. Keys are never sent to the client.
GROQ_API_KEYS=
# Backwards-compatible single key; merged into the pool and deduplicated.
GROQ_API_KEY=
# Fallback chat models, tried in order when the primary is unavailable or exhausted.
# Llama 3.1 8B is Enterprise-only on Groq; add it only if your account exposes it.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: ground-level monitoring observations (OpenAQ v3) ----------
# Free key: https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=

# --- Optional: MongoDB for saved locations + alert settings --------------
# Without this, AIR CUE uses server/data/store.json (local JSON fallback).
# Free tier: https://www.mongodb.com/products/platform/atlas-database
MONGODB_URI=
MONGODB_DB=aircue

# --- Optional tuning -----------------------------------------------------
CACHE_TTL_MS=300000
UPSTREAM_TIMEOUT_MS=12000
# Comma-separated origins if the client is hosted on a different domain.
CORS_ORIGIN=
